{
  "manifest_version": 3,
  "name": "Custom Sidebar",
  "description": "A compact side panel with your bookmarks above this window's tabs, plus an optional nightly sweep of unused tabs.",
  "version": "0.6.0",
  "minimum_chrome_version": "150",
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["alarms", "bookmarks", "favicon", "sidePanel", "storage", "tabGroups", "tabs", "webNavigation"],
  "side_panel": { "default_path": "panel.html" },
  "action": {
    "default_title": "Bookmarks and tabs",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+S", "mac": "Command+Shift+S" },
      "description": "Open or close the Sidebar"
    }
  },
  "options_page": "options.html",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "incognito": "not_allowed"
}
